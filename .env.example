# OAuth Configuration
# Copy this file to .env and fill in your OAuth provider details

# OAuth Client ID (required)
OAUTH_CLIENT_ID=your-client-id-here

# OAuth Client Secret (required)
OAUTH_CLIENT_SECRET=your-client-secret-here

# OAuth Authorization URL (required)
# Examples:
# - Google: https://accounts.google.com/o/oauth2/v2/auth
# - GitHub: https://github.com/login/oauth/authorize
# - Auth0: https://YOUR_DOMAIN.auth0.com/authorize
OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth

# OAuth Token URL (required)
# Examples:
# - Google: https://oauth2.googleapis.com/token
# - GitHub: https://github.com/login/oauth/access_token
# - Auth0: https://YOUR_DOMAIN.auth0.com/oauth/token
OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token

# OAuth Redirect URL (optional, defaults to http://localhost:8080/callback)
# This must match the redirect URI configured in your OAuth provider
OAUTH_REDIRECT_URL=http://localhost:8080/callback
